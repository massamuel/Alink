{
  "name": "alink",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts --dev",
    "start": "tsx server.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "scan": "semgrep scan --config semgrep/rules.yml fixtures --json",
    "test:api": "node scripts/verify-api.mjs && node scripts/verify-passkey.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.2.2",
    "@simplewebauthn/server": "^13.2.2",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "lucide-react": "^0.544.0",
    "mongodb": "^6.20.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.20.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.3"
  }
}
