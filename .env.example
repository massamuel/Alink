PORT=3000
APP_ORIGIN=http://localhost:3000
# Empty URI selects an explicitly labeled local JSON/binary store.
MONGODB_URI=
MONGODB_DB=alink
# Only the explicit Transcribe button sends audio to ElevenLabs.
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
# Optional local SpeechBrain service. No audio leaves the machine.
VOICE_SERVICE_URL=http://127.0.0.1:8001
# Experimental cosine threshold. Calibrate using consenting genuine/impostor samples.
VOICE_THRESHOLD=0.65
SEMGREP_BIN=

# Authenticated ElevenLabs Conversational AI agent; configure docs/BANK_AGENT.md.
ELEVENLABS_AGENT_ID=
